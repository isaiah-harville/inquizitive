# ---- Inquizitive server configuration (see docs/self-hosting.md) ----

# Database: SQLite file (single instance) or PostgreSQL (multiple replicas)
# DATABASE_URL=sqlite:./data/inquizitive.db
# DATABASE_URL=postgres://user:password@host:5432/inquizitive
# DATABASE_POOL_SIZE=10

# Image storage: "fs" (a directory / shared volume) or "s3" (any S3-compatible store)
# STORAGE_DRIVER=fs
# STORAGE_DIR=./data/media
# S3_ENDPOINT=https://s3.example.edu
# S3_REGION=us-east-1
# S3_BUCKET=inquizitive
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PREFIX=

# Authentication: none | local | oidc | proxy
AUTH_MODE=local
# Let people create their own accounts (local auth). The very first account is always allowed and becomes admin.
ALLOW_SIGNUP=false
# Optional bootstrap admin, created on first start (local auth)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-to-something-long
# SESSION_TTL_HOURS=336

# Public URL of this server (required for OIDC; enables Secure cookies over https)
# APP_URL=https://study.example.edu

# OpenID Connect (Keycloak, Microsoft Entra ID, Google Workspace, Authentik, ...)
# OIDC_ISSUER=https://login.example.edu/realms/school
# OIDC_CLIENT_ID=inquizitive
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
# OIDC_ALLOWED_DOMAINS=example.edu,students.example.edu
# OIDC_ADMIN_CLAIM=groups
# OIDC_ADMIN_VALUE=inquizitive-admins
# OIDC_PROVIDER_NAME=School account

# Trusted reverse-proxy headers (AUTH_MODE=proxy; only expose the app through that proxy!)
# PROXY_USER_HEADER=x-forwarded-user
# PROXY_EMAIL_HEADER=x-forwarded-email
# PROXY_NAME_HEADER=x-forwarded-preferred-username

# Spaced repetition target retention (0.70-0.97)
# FSRS_RETENTION=0.9
# MAX_UPLOAD_MB=10

# Compose-only settings
# APP_PORT=3000
# POSTGRES_PASSWORD=inquizitive
# S3_BUCKET=inquizitive
