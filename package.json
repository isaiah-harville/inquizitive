{
  "name": "inquizitive",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "prepare:assets": "bun scripts/gen-migrations.ts && bun scripts/prepare-assets.ts",
    "dev": "bun run prepare:assets && next dev",
    "dev:web": "bun run prepare:assets && next dev",
    "build": "bun run build:server",
    "build:server": "bun run prepare:assets && INQUIZITIVE_TARGET=server next build",
    "build:web": "bun run prepare:assets && INQUIZITIVE_TARGET=static NEXT_PUBLIC_BACKEND=local next build",
    "build:browser": "bun run prepare:assets && INQUIZITIVE_TARGET=static NEXT_PUBLIC_BACKEND=browser next build",
    "start": "bun scripts/start-standalone.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri",
    "test": "bun scripts/gen-migrations.ts && vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "check": "bun run lint && bun run typecheck && bun run check:length && bun run test && bun run test:pg && bun run test:rust",
    "db:up": "docker run -d --rm --name inquizitive-test-pg -e POSTGRES_PASSWORD=test -p 55432:5432 postgres:17-alpine && until docker exec inquizitive-test-pg pg_isready -U postgres >/dev/null 2>&1; do sleep 1; done",
    "db:down": "docker stop inquizitive-test-pg",
    "test:pg": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres:test@127.0.0.1:55432/postgres} vitest run tests/integration",
    "check:length": "sh scripts/check-file-length.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@tanstack/react-query": "^5.108.2",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.9.0",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "fflate": "^0.8.3",
    "geist": "^1.9.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "openid-client": "^6.9.1",
    "papaparse": "^5.7.1",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "ts-fsrs": "^6.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "description": "Offline-first, open-source study app: flashcards, learn, tests, matching and spaced repetition. Desktop or self-hosted.",
  "license": "MIT"
}
